{
  "id": "translate-to-armenian",
  "releases": [
    {
      "version": "1.0.1",
      "releaseDate": "2026-10-01T14:30:00Z",
      "services": [
        {
          "name": "Google Translate",
          "description": "Translates the selected text.",
          "origins": ["https://translation.googleapis.com"]
        }
      ],
      "variables": {
        "{gcp_key}": {
          "name": "GCP Key",
          "description": "The Google Cloud Platform API key used for translation requests."
        }
      },
      "dynamicVariables": ["{selected_text}"]
    },
    {
      "version": "1.0.0",
      "releaseDate": "2026-09-01T14:30:00Z",
      "services": [
        {
          "name": "Google Translate",
          "description": "Translates the selected text.",
          "origins": ["https://translation.googleapis.com"]
        }
      ],
      "variables": {
        "{google_translate_key}": {
          "name": "Google Translate Key",
          "description": "The Google Translate API key used for translation requests."
        }
      },
      "dynamicVariables": ["{selected_text}"]
    }
  ]
}
